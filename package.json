{
  "name": "blastr",
  "version": "1.0.0",
  "private": true,
  "description": "Broadcast relay for SmartFlowSocial. Gates signed Nostr events by pubkey entitlement and fans them out to a curated relay set.",
  "author": "SmartFlowSocial",
  "license": "Unlicense",
  "homepage": "https://smartflow.social",
  "repository": {
    "type": "git",
    "url": "https://github.com/xdzczk/smartflowsocial-blastr.git"
  },
  "bugs": {
    "url": "https://github.com/xdzczk/smartflowsocial-blastr/issues"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --fix .",
    "lint:ci": "eslint . --format json --output-file eslint-report.json || exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck",
    "precheck": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/core tests/services tests/utils tests/logger.test.ts",
    "test:integration": "vitest run tests/transport tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "hono": "^4.12.25",
    "nostr-tools": "^2.19.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.73.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.3",
      "esbuild": ">=0.25.0",
      "brace-expansion": ">=5.0.11 <6",
      "browserslist": ">=4.28.7 <5",
      "flatted": ">=3.4.2 <4",
      "js-yaml": ">=4.3.2 <5",
      "nanoid": ">=3.3.18 <4",
      "picomatch@^2.3.1": "2.3.2",
      "picomatch@>=4": "4.0.7",
      "postcss": ">=8.5.18 <9",
      "sharp": ">=0.35.5 <0.36",
      "source-map-js": ">=1.2.2 <2",
      "undici": ">=7.30.1 <8",
      "ws": ">=8.21.0 <9"
    }
  }
}
